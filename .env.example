# Copy this file to .env on the server and replace all placeholder values.
# Never commit the populated .env file.

FTP_HOST=ftp.example.com
FTP_USER=replace_me
FTP_PASS=replace_me

LEGALSUITE_API_KEY=replace_me

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_AUTH_MODE=login
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=replace_me@example.com
